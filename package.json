{
  "name": "comdove-fake-backend",
  "version": "1.0.0",
  "description": "Fake WhatsApp / Meta Cloud API mock server for testing Comdove (wat-backend) end to end.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "fake-comdove": "tsx tools/fake-comdove.ts",
    "tab": "tsx tools/tab.ts",
    "seed-comdove": "tsx tools/seed-comdove.ts",
    "fixtures": "tsx tools/gen-fixtures.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacxio/comdove-fake-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/stacxio/comdove-fake-backend/issues"
  },
  "homepage": "https://github.com/stacxio/comdove-fake-backend#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
