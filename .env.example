# --- Fake server config (API Tech Spec §8) ---
PORT=4020
# Where inbound + status webhooks are POSTed (wat-backend host:port + /webhooks/whatsapp)
COMDOVE_WEBHOOK_URL=http://localhost:3000/webhooks/whatsapp
# HMAC key for X-Hub-Signature-256. MUST equal wat-backend's META_APP_SECRET
APP_SECRET=mock-app-secret-1
# Sent as hub.verify_token in the handshake. MUST equal wat-backend's WHATSAPP_VERIFY_TOKEN
WEBHOOK_VERIFY_TOKEN=mock-verify-1
# SQLite file; delete it for a factory reset
DB_PATH=./mock.sqlite

# Wait before the first status webhook so Comdove has stored the wamid (plan §9f). Optional.
STATUS_WEBHOOK_DELAY_MS=500
# WebSocket heartbeat: ping every N ms; a client that misses a pong is dropped (FR-16)
WS_HEARTBEAT_MS=15000
# Conversations allowed a webhook in flight at once. 5 businesses x 100 tiles is 500
# conversations; uncapped, they would all call Comdove at the same instant (WS-343)
WEBHOOK_MAX_PARALLEL=20
